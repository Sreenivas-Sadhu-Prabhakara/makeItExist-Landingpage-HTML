{
  "name": "makeitexist-booking",
  "version": "1.0.0",
  "description": "Make It Exist - Student Tech Project Booking System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Static site with backend'",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "globalSetup": "./tests/globalSetup.js",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js"
    ]
  },
  "keywords": [
    "makeitexist",
    "booking",
    "projects"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.9.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^2.0.20",
    "supertest": "^7.2.2"
  }
}
