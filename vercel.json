{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/logout", "destination": "/api/index.js" },
    { "source": "/admin/login", "destination": "/api/index.js" },
    { "source": "/admin/logout", "destination": "/api/index.js" }
  ]
}
